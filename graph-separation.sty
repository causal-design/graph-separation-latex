% B2: 90% of the former 0.515cm path span, 0.45pt stroke at 10pt.
% Every endpoint variant shares the same wave, advance and mathematical axis.
% Dimensions scale with the active traditional math-symbol font's quad.
\newdimen\gs@em
\newdimen\gs@axis
\newdimen\gs@length
\newdimen\gs@weight
\newdimen\gs@amplitude
\newdimen\gs@guard
\newdimen\gs@wave
\newdimen\gs@head
\newdimen\gs@height
\newdimen\gs@xone
\newdimen\gs@xtwo
\newdimen\gs@xthree
\newdimen\gs@xfour
\newdimen\gs@end
\newcommand{\gs@draw}[2]{%
  \begingroup
  \ifx#1\scriptstyle
    \gs@em=\fontdimen6\scriptfont2
    \gs@axis=\fontdimen22\scriptfont2
  \else\ifx#1\scriptscriptstyle
    \gs@em=\fontdimen6\scriptscriptfont2
    \gs@axis=\fontdimen22\scriptscriptfont2
  \else
    \gs@em=\fontdimen6\textfont2
    \gs@axis=\fontdimen22\textfont2
  \fi\fi
  \gs@length=1.318785236\gs@em
  \gs@weight=.045\gs@em
  \gs@amplitude=.08\gs@em
  \gs@guard=.32\gs@em
  \gs@head=.28452756\gs@em
  \gs@height=.32\gs@em
  \gs@wave=\gs@length \advance\gs@wave by-2\gs@guard
  \gs@end=\gs@length \advance\gs@end by-\gs@guard
  \gs@xone=.125\gs@wave \advance\gs@xone by\gs@guard
  \gs@xtwo=.375\gs@wave \advance\gs@xtwo by\gs@guard
  \gs@xthree=.625\gs@wave \advance\gs@xthree by\gs@guard
  \gs@xfour=.875\gs@wave \advance\gs@xfour by\gs@guard
  \begin{tikzpicture}[baseline=-\gs@axis,line width=\gs@weight,
      line cap=butt,line join=miter]
    % The body is centrally symmetric. Heads sit on separate straight stubs;
    % adding heads cannot shorten, rephase or distort the two-cycle wave.
    \draw (0,0) -- (\gs@guard,0)
      -- (\gs@xone,\gs@amplitude) -- (\gs@xtwo,-\gs@amplitude)
      -- (\gs@xthree,\gs@amplitude) -- (\gs@xfour,-\gs@amplitude)
      -- (\gs@end,0) -- (\gs@length,0);
    \ifcase#2\relax
    \or
      \draw[-{Classical TikZ Rightarrow[length=\the\gs@head]}]
        (\gs@end,0) -- (\gs@length,0);
    \or
      \draw[{Classical TikZ Rightarrow[length=\the\gs@head]}-]
        (0,0) -- (\gs@guard,0);
    \or
      \draw[{Classical TikZ Rightarrow[right,length=\the\gs@head]}-]
        (0,0) -- (\gs@guard,0);
      \draw[-{Classical TikZ Rightarrow[right,length=\the\gs@head]}]
        (\gs@end,0) -- (\gs@length,0);
    \or
      \draw[{Classical TikZ Rightarrow[right,length=\the\gs@head]}-]
        (0,0) -- (\gs@guard,0);
      \draw[-{Classical TikZ Rightarrow[length=\the\gs@head]}]
        (\gs@end,0) -- (\gs@length,0);
    \or
      \draw[{Classical TikZ Rightarrow[length=\the\gs@head]}-]
        (0,0) -- (\gs@guard,0);
      \draw[-{Classical TikZ Rightarrow[right,length=\the\gs@head]}]
        (\gs@end,0) -- (\gs@length,0);
    \or
      \draw[{Classical TikZ Rightarrow[length=\the\gs@head]}-]
        (0,0) -- (\gs@guard,0);
      \draw[-{Classical TikZ Rightarrow[length=\the\gs@head]}]
        (\gs@end,0) -- (\gs@length,0);
    \fi
    \pgfresetboundingbox
    \path[use as bounding box] (0,-\gs@height)
      rectangle (\gs@length,\gs@height);
  \end{tikzpicture}%
  \endgroup}
\newcommand\nosquigno{\mathrel{\mathpalette\gs@draw{0}}}
\newcommand\nosquigfull{\mathrel{\mathpalette\gs@draw{1}}}
\newcommand\fullsquigno{\mathrel{\mathpalette\gs@draw{2}}}
\newcommand\halfsquighalf{\mathrel{\mathpalette\gs@draw{3}}}
\newcommand\halfsquigfull{\mathrel{\mathpalette\gs@draw{4}}}
\newcommand\fullsquighalf{\mathrel{\mathpalette\gs@draw{5}}}
\newcommand\fullsquigfull{\mathrel{\mathpalette\gs@draw{6}}}

% Straight relations retain the published v2.0 drawing and physical dimensions.
\newcommand{\gs@straight}[1]{%
  \mathrel{\adjustbox{valign=c}{\begin{tikzpicture}
    \draw[line width=0.5pt,#1] (0,0) -- (0.515,0);
  \end{tikzpicture}}}}
\newcommand\nostraigno{\gs@straight{-}}
\newcommand\nostraigfull{\gs@straight{-{Classical TikZ Rightarrow[length=1mm]}}}
\newcommand\fullstraigno{\gs@straight{{Classical TikZ Rightarrow[length=1mm]}-}}
\newcommand\halfstraighalf{\gs@straight{{Classical TikZ Rightarrow[right,length=1mm]}-{Classical TikZ Rightarrow[right,length=1mm]}}}
\newcommand\halfstraigfull{\gs@straight{{Classical TikZ Rightarrow[right,length=1mm]}-{Classical TikZ Rightarrow[length=1mm]}}}
\newcommand\fullstraighalf{\gs@straight{{Classical TikZ Rightarrow[length=1mm]}-{Classical TikZ Rightarrow[right,length=1mm]}}}
\newcommand\fullstraigfull{\gs@straight{{Classical TikZ Rightarrow[length=1mm]}-{Classical TikZ Rightarrow[length=1mm]}}}
